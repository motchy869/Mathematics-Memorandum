Cell["\<\
We can see that the observer point \[DoubleStruckP] \
\[OpenCurlyDoubleQuote]feel\[CloseCurlyDoubleQuote]s the \
\[OpenCurlyDoubleQuote]radiation wind\[CloseCurlyDoubleQuote] from ONLY \
INSIDE the sphere whose radius is p.\
\>", "Text",
 CellChangeTimes->{{3.845107632541836*^9, 3.8451078326968527`*^9}, {
  3.845108258738053*^9, 
  3.8451082628509593`*^9}},ExpressionUUID->"0abf7b75-dbc6-4018-a1a3-\
8624df55bfdc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Visualize the norm of A(R).", "Subsection"]], \
"Section",
 CellChangeTimes->{{3.845107600215786*^9, 
  3.84510761785509*^9}},ExpressionUUID->"10bf8e4a-cd93-4899-81d9-\
4058791bf31d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"norm\[LetterSpace]A", "[", "R_", "]"}], "=", 
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"R", ">", "0"}], "&&", 
     RowBox[{"p", ">", "0"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Norm", "[", "A\[LetterSpace]1", "]"}], ",", 
          RowBox[{"R", "<", "p"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Norm", "[", "A\[LetterSpace]2", "]"}], ",", 
          RowBox[{"R", "==", "p"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Norm", "[", "A\[LetterSpace]3", "]"}], ",", 
          RowBox[{"R", ">", "p"}]}], "}"}]}], "}"}], "]"}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.845107848392682*^9, 3.845107941136284*^9}, {
  3.8451080398446364`*^9, 3.8451081075721273`*^9}},
 CellLabel->
  "(Local) In[70]:=",ExpressionUUID->"96da51df-2d29-427f-841c-308b7d5f85c3"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        FractionBox[
         RowBox[{"4", " ", "\[Pi]", " ", 
          SuperscriptBox["R", "3"]}], 
         RowBox[{"3", " ", 
          SuperscriptBox["p", "2"]}]], 
        RowBox[{"R", "<", "p"}]},
       {
        FractionBox[
         RowBox[{"4", " ", "\[Pi]", " ", "R"}], "3"], 
        RowBox[{"p", "\[Equal]", "R"}]},
       {
        FractionBox[
         RowBox[{"4", " ", "p", " ", "\[Pi]"}], "3"], 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
      Editable->True,
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
