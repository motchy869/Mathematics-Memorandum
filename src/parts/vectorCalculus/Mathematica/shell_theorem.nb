     RowBox[{
      RowBox[{"\[DoubleStruckR]", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", "r"}], 
     "]"}], "\[CapitalDelta]r"}]}], ";"}]], "Input",
