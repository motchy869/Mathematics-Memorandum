Cell[CellGroupData[{

Cell[TextData[StyleBox["Define the vector field A(R), which is the sum of \
infinitely many radial vectors spread from a sphere whose radius is R > 0.", \
"Subsection"]], "Section",
 CellChangeTimes->{{3.8451059844259667`*^9, 3.8451060135623417`*^9}, {
  3.8451060473389273`*^9, 3.845106063662736*^9}, {3.84510609582521*^9, 
  3.8451062568024178`*^9}, {3.845106308879002*^9, 3.8451063090521717`*^9}, {
  3.8451065747422256`*^9, 
  3.845106575108858*^9}},ExpressionUUID->"d4ac7b58-d1dc-4422-8e18-\
8ae19e674320"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "[", "R_", "]"}], ":=", 
  RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[DoubleStruckP]", "-", 
        RowBox[{"\[DoubleStruckR]", "[", 
         RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"\[DoubleStruckP]", "-", 
          RowBox[{"\[DoubleStruckR]", "[", 
           RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], "]"}], "^",
         "3"}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"w", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
       "\[CapitalDelta]r", "*", "\[CapitalDelta]\[Theta]", "*", 
        "\[CapitalDelta]\[Phi]"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"r", ",", "0", ",", "R"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Phi]", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.8451062950514646`*^9, 3.8451062961513863`*^9}, {
  3.8451063595636744`*^9, 3.8451065115036154`*^9}, {3.845106623516822*^9, 
  3.845106635182928*^9}},
 CellLabel->
  "(Local) In[36]:=",ExpressionUUID->"6cddff17-70c8-44dc-81a0-0706340f4b62"]
}, Open  ]],

