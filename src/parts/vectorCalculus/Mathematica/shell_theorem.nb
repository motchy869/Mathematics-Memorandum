Cell[CellGroupData[{

Cell[TextData[StyleBox["Calculate the micro-volume-element \
w(r,\[Theta],\[Phi]).", "Subsection"]], "Section",
 CellChangeTimes->{{3.845105634540312*^9, 3.845105649297718*^9}, {
  3.8451057019481945`*^9, 
  3.845105731887785*^9}},ExpressionUUID->"8800c5aa-cae9-4ce7-8f77-\
f54ce87af168"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"w", "[", 
   RowBox[{"r_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"\[DoubleStruckV]1", "[", 
     RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ".", 
    RowBox[{"Cross", "[", 
     RowBox[{
      RowBox[{"\[DoubleStruckV]2", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], ",", 
      RowBox[{"\[DoubleStruckV]3", "[", 
       RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.845105752863357*^9, 3.845105803676307*^9}},
 CellLabel->
  "(Local) In[53]:=",ExpressionUUID->"67a1cd62-a54b-43d0-9c80-99f483ace447"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["r", "2"], " ", "\[CapitalDelta]r", " ", 
  "\[CapitalDelta]\[Theta]", " ", "\[CapitalDelta]\[Phi]", " ", 
  RowBox[{"Sin", "[", "\[Theta]", "]"}]}]], "Output",
 CellChangeTimes->{{3.845105793665303*^9, 3.845105803934252*^9}, 
   3.845107331422439*^9},
 CellLabel->
  "(Local) Out[53]=",ExpressionUUID->"4698dc25-c7dd-492e-a900-3dc5613921c5"]
}, Open  ]]
}, Open  ]],

