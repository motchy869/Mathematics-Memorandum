Cell[CellGroupData[{
Cell["\<\
Demonstration to solve \[OpenCurlyDoubleQuote]Shell Theorem\
\[CloseCurlyDoubleQuote] which appears quite frequently in gravitational and \
electric field.\
\>", "Section",
 CellChangeTimes->{{3.8451067436473045`*^9, 3.8451068850216293`*^9}, {
   3.845106989830619*^9, 3.845106994193426*^9}, {3.845107202795721*^9, 
   3.8451072057705936`*^9}, 
   3.8451741898389297`*^9},ExpressionUUID->"ff26fe69-132a-4804-b501-\
cc06f059274b"],

Cell[CellGroupData[{

Cell["Define the position vector \[DoubleStruckR](r,\[Theta],\[Phi])", \
"Subsection",
 CellChangeTimes->{{3.8451052364173975`*^9, 
  3.845105267211651*^9}},ExpressionUUID->"a66c9aae-ba59-4731-8b5e-\
c5cd3aa3269b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[DoubleStruckR]", "[", 
    RowBox[{"r_", ",", "\[Theta]_", ",", "\[Phi]_"}], "]"}], "=", 
   RowBox[{"r", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.845105473705903*^9, 3.8451054986102266`*^9}},
 CellLabel->
  "(Local) In[22]:=",ExpressionUUID->"2633e967-6e2c-44d8-85ab-ce642d4996ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[DoubleStruckR]", "[", 
   RowBox[{"r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.8451054878865995`*^9, 3.8451054881606417`*^9}},
 CellLabel->
  "(Local) In[23]:=",ExpressionUUID->"a142b3c8-8bf5-4e8a-9594-765054b229a5"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", 
   TagBox[GridBox[{
      {
       RowBox[{"r", " ", 
        RowBox[{"Cos", "[", "\[Phi]", "]"}], " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}]},
      {
       RowBox[{"r", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"Sin", "[", "\[Phi]", "]"}]}]},
      {
       RowBox[{"r", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.5599999999999999]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    Column], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{
  3.8451052302446685`*^9, {3.8451054886299305`*^9, 3.8451055031071177`*^9}},
 CellLabel->
  "(Local) Out[23]//MatrixForm=",ExpressionUUID->"4e388932-9994-4845-8bad-\
2bb0ba97ef3e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Define the micro-displacement vectors \[DoubleStruckV]1(\[Theta],\[Phi]), \
\[DoubleStruckV]2(\[Theta],\[Phi]) and \[DoubleStruckV]3(\[Theta],\[Phi]).\
\>", "Subsection",
 CellChangeTimes->{{3.8451053479786835`*^9, 3.845105350857112*^9}, {
