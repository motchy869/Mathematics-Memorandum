{
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build-out",
    "latex-workshop.latex.tools": [
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "-file-line-error",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-halt-on-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
