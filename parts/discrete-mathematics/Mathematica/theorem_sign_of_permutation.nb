Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"nTest", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"list", "=", 
       RowBox[{"RandomSample", "[", 
        RowBox[{"Range", "[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cycles", "=", 
       RowBox[{"PermutationCycles", "[", "list", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"list2", "=", 
       RowBox[{"n", "+", "1", "-", 
        RowBox[{"PermutationReplace", "[", 
         RowBox[{
          RowBox[{"Range", "[", "n", "]"}], ",", "cycles"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cycles2", "=", 
       RowBox[{"PermutationCycles", "[", "list2", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SgnOfPermutation", "[", "cycles", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"n", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "/", "2"}]}], ")"}]}], "*", 
        RowBox[{"SgnOfPermutation", "[", "cycles2", "]"}]}]}]}], 
     "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "nTest", "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
