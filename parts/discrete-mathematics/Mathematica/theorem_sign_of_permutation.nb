Cell[TextData[StyleBox["Test Of theorem about the sign of \[Sigma](n+1-i)", \
"Section"]], "Text",
 CellChangeTimes->{{3.810778996983239*^9, 
  3.8107790443821774`*^9}},ExpressionUUID->"ab380064-0dde-4c4f-985b-\
1f727ce1c17c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"nTest", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"list", "=", 
       RowBox[{"RandomSample", "[", 
        RowBox[{"Range", "[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"list2", "=", 
       RowBox[{"SigmaDash", "[", "list", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"cycles", "=", 
       RowBox[{"PermutationCycles", "[", "list", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cycles2", "=", 
       RowBox[{"PermutationCycles", "[", "list2", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"SgnOfPermutation", "[", "cycles", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"n", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "/", "2"}]}], ")"}]}], "*", 
        RowBox[{"SgnOfPermutation", "[", "cycles2", "]"}]}]}]}], 
     "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "nTest", "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
