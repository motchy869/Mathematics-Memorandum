Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"SigmaDash", "[", "t_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"t", "[", 
     RowBox[{"[", 
      RowBox[{"n", "+", "1", "-", "i"}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "t", "]"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8107755695446663`*^9, 3.8107756972170773`*^9}, {
  3.810777387139846*^9, 3.81077739358407*^9}},
 CellLabel->
  "In[230]:=",ExpressionUUID->"a908563e-5f67-4c50-b91b-038acba05535"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SgnOfPermutation", "[", "cs_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "\[LessEqual]", 
        RowBox[{"Length", "[", 
         RowBox[{"cs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "+=", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"cs", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "i"}], "]"}], "]"}], "]"}], "-", "1"}]}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", "s"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8107757426429853`*^9, 3.810775866432169*^9}, {
   3.810775920714752*^9, 3.810776030420103*^9}, {3.8107768152526617`*^9, 
   3.81077681625161*^9}, 3.810776848379177*^9, {3.810778389554491*^9, 
   3.810778391901742*^9}, {3.810778431219213*^9, 3.8107784312433443`*^9}, {
   3.810778468667617*^9, 3.8107784904029207`*^9}},
 CellLabel->
  "In[231]:=",ExpressionUUID->"dc410b3e-dcfd-4264-bf6c-b748087428f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nTest", "=", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "50"}], "}"}], ",", "1000"}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.810778535549282*^9, 3.810778537652062*^9}, {
   3.8107785822475233`*^9, 3.810778615250023*^9}, {3.8107787573405237`*^9, 
